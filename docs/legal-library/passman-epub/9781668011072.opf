  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:title id="t1">All You Need to Know About the Music Business</dc:title>
    <dc:title id="t2">Eleventh Edition</dc:title>
    <dc:creator id="id-1">Donald S. Passman</dc:creator>
    <dc:identifier>calibre:13636</dc:identifier>
